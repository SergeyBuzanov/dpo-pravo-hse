<?xml version="1.0" encoding="UTF-8"?>
<!-- Карта сайта для поисковых систем.
     ЗАМЕНИТЕ https://example.com на реальный домен после публикации.

     Адреса КАНОНИЧЕСКИЕ, а не имена файлов: nginx уводит «/Каталог
     программ.html» и «/privacy.html» на «/catalog» и «/privacy»
     редиректом 301. Пока в карте стояли имена файлов, поисковику
     давались взаимоисключающие указания — карта вела на адрес,
     который тут же перенаправлял, а страница объявляла каноническим
     третий вариант. Красивые адреса при этом не ранжировались. -->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>https://example.com/</loc>
    <changefreq>monthly</changefreq>
    <priority>1.0</priority>
  </url>
  <url>
    <loc>https://example.com/catalog</loc>
    <changefreq>weekly</changefreq>
    <priority>0.9</priority>
  </url>
  <url>
    <loc>https://example.com/privacy</loc>
    <changefreq>yearly</changefreq>
    <priority>0.2</priority>
  </url>
</urlset>
