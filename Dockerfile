# Админка каталога (admin-server.js): чистый Node, npm-зависимостей нет.
# Нужен Node 18+ ради нативного fetch — берём 20 LTS.
FROM node:20-alpine

WORKDIR /app
COPY --chown=node:node . .

# В контейнере слушаем 0.0.0.0, наружу порт публикуется только на 127.0.0.1 хоста
# (см. docker-compose.yml) — снаружи сети админка по-прежнему недоступна.
ENV HOST=0.0.0.0
ENV PORT=5178
EXPOSE 5178

# Не root: админка пишет файлы в примонтированный каталог сайта, и работать
# при этом с правами root незачем. Образ node:20-alpine содержит готового
# пользователя node (uid 1000).
#
# ВАЖНО при развёртывании: каталог сайта монтируется с хоста и перекрывает
# права из образа, поэтому он должен быть доступен на запись uid 1000 —
# иначе кнопка «Обновить» вернёт ошибку записи (она будет видна в статусе
# админки, молча ничего не сломается). На сервере: chown -R 1000:1000 /srv/dpo
USER node

CMD ["node", "admin-server.js"]
