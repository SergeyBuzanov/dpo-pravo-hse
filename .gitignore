# Локальные секреты и runtime-состояние админки — НЕ коммитить
.admin-credentials.json
.admin-status.json
.catalog-schedule.json
.catalog-update.lock
.load-test-report.json
.analytics/

# Заявки на программы — ПЕРСОНАЛЬНЫЕ ДАННЫЕ живых людей: имя, телефон, почта.
# В репозитории им не место ни при каких обстоятельствах: git-история
# неудаляема на практике, а копия репозитория есть на GitHub и на каждой
# машине, куда его клонировали. Каталог лежит рядом с проектом только потому,
# что так его видит админка; права на него — 0700, на файлы — 0600.
.applications/

# .catalog-data.json СОЗНАТЕЛЬНО коммитится, хотя и лежит рядом с локальным
# состоянием админки. Из него собираются страницы программ, а они в репозитории
# есть – без данных их нельзя воспроизвести на чистой машине. Внутри только
# публичный каталог hse.ru: ни доступов, ни персональных данных. Обновление
# каталога меняет этот файл, и это правильно: правки видны в истории git.

# Правка лендинга: распакованный шаблон и резервная копия перед упаковкой.
# Источник истины – сам index.html; коммит распакованной копии создал бы
# вторую версию разметки, которая молча разойдётся с настоящей.
.landing-template.html
.index.html.bak

# Логи
*.log

# Системное
.DS_Store
node_modules/
*.tmp
.claude/

# Рабочее состояние скилла impeccable: журналы live-сессий, конфиг детектора
# и сайдкар дизайн-системы. Сам DESIGN.md лежит в корне и коммитится.
.impeccable/

# Публичная выкладка для зеркала: артефакт сборки scripts/build-public.js.
# Собирается заново одной командой, в истории ей делать нечего.
.public/

# Бинарники инструмента стилизации портретов (пересобираются swiftc)
scripts/cutout/cutout
scripts/cutout/stylize
# Playwright CLI output (may contain credentials)
.playwright-cli/
